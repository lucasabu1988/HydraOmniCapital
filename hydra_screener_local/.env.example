# HYDRA Screener - Webhook / Notification config (hybrid flow)
# Copy this file to .env (in the project root) and fill real values.
# .env is gitignored. Never commit real secrets.
#
# The sender (send_hydra_summary.py) and auto-calls from screener/run_real will read these.
# Both bare names and HYDRA_ prefixed aliases are supported (HYDRA_ takes precedence if both set).

# --- Discord (embed with regime, pillars, top tickers + strict flags) ---
# Create a webhook in your server: Server Settings > Integrations > Webhooks > New Webhook > copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz-1234567890
# or the alias:
# HYDRA_DISCORD_WEBHOOK=...

# --- Telegram (markdownV2 message) ---
# 1. Create bot with @BotFather -> get token
# 2. Add bot to your channel/group or start chat, get chat_id (use @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567
TELEGRAM_CHAT_ID=-1001234567890
# aliases:
# HYDRA_TELEGRAM_BOT_TOKEN=...
# HYDRA_TELEGRAM_CHAT_ID=...

# --- Generic webhook (full JSON POST, for n8n, Zapier, custom server, Make, etc.) ---
GENERIC_WEBHOOK_URL=https://your-endpoint.example.com/hydra-webhook
# HYDRA_GENERIC_WEBHOOK=...

# Notes:
# - At least one of the above sections is needed for remote notifications; artifacts (json/txt/watchlist) are *always* written locally to pine/ regardless.
# - pip install requests   (if not present, sender will warn and only produce local files)
# - The loader in send_hydra_summary (and future) will auto-load .env if python-dotenv installed, or use a built-in simple parser.
# - For local testing without real hooks: leave unset, run screener, inspect pine/hydra_last_summary.* and watchlist.txt
