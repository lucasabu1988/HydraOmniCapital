//@version=5
indicator("HYDRA Screener [Hybrid v1.2]", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_labels_count=500)

// =============================================
// HYDRA Scoring - Pine Script v5 (Watchlist Dashboard + Per-Symbol)
// 
// This is the TradingView side of the hybrid system (see HYDRA_ALGORITHM_SPEC.md).
// 
// Architecture:
// - Python (heavy lifter): Scans the full universe (~2500 tickers daily), applies full HYDRA logic, 
//   produces ranked list + history/backtest. Outputs top candidates via alert/webhook.
// - User: Adds the suggested symbols to a personal "HYDRA Watchlist" in TradingView.
// - This Pine Script: 
//   1. Computes accurate per-symbol HYDRA scoring when applied to any chart.
//   2. Builds a professional dashboard TABLE for a user-provided watchlist (paste symbols from Python output).
//   3. Shows rich visuals, components, Special Modes, Pillar Multipliers, Strict Filter status.
//   4. Fires alerts for recommended / high conviction setups (can be sent to webhooks).
//
// Limitations respected:
// - No attempt to scan 2500 tickers inside Pine (impossible due to security() limits + performance).
// - Watchlist size capped (recommend 15-20 symbols for performance).
// - Sector control approximated or noted (full version expensive in Pine).
//
// Matches the spec as closely as possible in Pine constraints.
// =============================================

// --- Inputs (aligned with spec parameters) ---
i_spy                = input.symbol("SPY", "Market Proxy for Regime")
i_mom_len            = input.int(90, "Momentum Lookback", group="Momentum")
i_vol_len            = input.int(63, "Vol Lookback for Momentum", group="Momentum")

i_short_len          = input.int(10, "Short-term Ret Lookback", group="Short-Term & Strict")
i_prox_len           = input.int(20, "Proximity to High Days", group="Short-Term & Strict")
i_strict_ret         = input.float(15.0, "Strict Min Ret %", group="Short-Term & Strict")
i_strict_dist        = input.float(-2.0, "Strict Max Dist to High %", group="Short-Term & Strict")
i_vol_base           = input.float(1.50, "Base Vol Surge Threshold", group="Short-Term & Strict")
i_geo_risk           = input.float(0.0, "Geopolitical Risk (0-1)", minval=0, maxval=1, step=0.1, group="Short-Term & Strict")

// SPEC 4.7 - Downtrend Veto Gate (solo-en-negativo: ret 10d < 0 es condición necesaria; sobre eso, OR de las dos señales)
i_gate_on            = input.bool(true, "Enable Downtrend Veto Gate", group="Downtrend Veto Gate (SPEC 4.7)")
i_gate_dist          = input.float(-8.0, "Veto: Max Dist to High %", group="Downtrend Veto Gate (SPEC 4.7)")
i_gate_ret           = input.float(-5.0, "Veto: Min Ret 10d %", group="Downtrend Veto Gate (SPEC 4.7)")

i_regime_len         = input.int(200, "Regime SMA Length", group="Regime")
i_strong_th          = input.float(0.62, "STRONG threshold", group="Regime")
i_moderate_th        = input.float(0.50, "MODERATE threshold", group="Regime")
i_cautious_th        = input.float(0.38, "CAUTIOUS threshold", group="Regime")

i_base_recs          = input.int(14, "Base Recommendations", group="Dynamic Count")
i_min_recs           = input.int(6, "Min Recommendations", group="Dynamic Count")
i_max_recs           = input.int(28, "Max Recommendations", group="Dynamic Count")
i_min_regime_rec     = input.float(0.35, "Min Regime for Recommended (*0.85)", group="Dynamic Count")

i_watchlist          = input.string("AAPL,MSFT,NVDA,AMZN,GOOGL,META,AVGO,TSLA,AMD,NVDA", "Watchlist Symbols (comma separated - paste from Python)", group="Watchlist Dashboard")
i_max_watchlist      = input.int(15, "Max symbols in table (performance)", minval=5, maxval=30, group="Watchlist Dashboard")
i_show_table         = input.bool(true, "Show Watchlist Dashboard Table", group="Watchlist Dashboard")
i_color_rows         = input.bool(true, "Color rows by Regime / Strict", group="Watchlist Dashboard")

i_summary_json       = input.string("", "Optional: paste FULL content of pine/hydra_last_summary.json (rich header + pillars + exact Rec? from recommended_tickers)", group="Watchlist Dashboard")
i_only_recommended   = input.bool(false, "Filter table to Python recommended only (when JSON provided)", group="Watchlist Dashboard")

i_show_pillars       = input.bool(true, "Show Pillar Multipliers on Chart", group="Visuals")
i_show_special       = input.bool(true, "Show Special Mode Labels", group="Visuals")

// --- Constants from SPEC ---
var float STRICT_BONUS = 0.18
var float SHORT_BOOST  = 0.35
var float MIN_VOL_TH   = 1.0

// --- Parse optional summary JSON for global info (rationale, pillars, regime, top_details, recommended) ---
// Robust crude parser (no native JSON in Pine v5). String find/substring/split/replace.
// Designed for the exact output of send_hydra_summary.py + build_rich_summary (see SPEC + HYBRID_USAGE).
// - Rationale extracted BEFORE space-strip so internal spaces/punctuation preserved.
// - Regime scoped to its object.
// - top_details parsed into parallel arrays (ticker -> composite/momentum/passes_strict/special_modes).
// - recommended_count + recommended_tickers array parsed for *exact* Rec? flags in the table (when JSON pasted).
// - Field extraction tolerant to last-property (uses closing quote for strings, , or } for nums/bools).
var string summary_rationale = ""
var string summary_pillars_str = ""
var string summary_regime = ""
var float summary_regime_score = 0.0
var int summary_recommended_count = 0

// For per-ticker enrichment from top_details (Python exact values win over local approx)
var string[] detail_tickers = array.new_string()
var float[] detail_composites = array.new_float()
var float[] detail_momentums = array.new_float()
var bool[] detail_stricts = array.new_bool()
var string[] detail_specials = array.new_string()
var float[] detail_ranks = array.new_float()  // Python rank from top_details for exact ordering in table

// Authoritative recommended list from Python (for exact "Rec?" in dashboard table)
var string[] recommended_tickers_py = array.new_string()
var bool has_recommended_from_py = false
var bool use_json_global = false  // when true and regime in JSON, bypass local global regime calc (B1 JSON-slave mode)

if i_summary_json != ""
    src = str.replace_all(i_summary_json, "\n", "")

    // Rationale first (preserve spaces inside value, e.g. "SPECIAL: Strong Momentum")
    rat_key = '"rationale":"'
    rat_pos = str.pos(src, rat_key)
    if rat_pos >= 0
        rat_val_start = rat_pos + str.length(rat_key)
        rat_val_end = str.pos(src, '"', rat_val_start)
        if rat_val_end > rat_val_start
            summary_rationale := str.substring(src, rat_val_start, rat_val_end)

    // Compact version for keys, numbers, bools, ID strings (safe: tickers/specials have no spaces)
    cleaned := str.replace_all(src, " ", "")

    // Regime: score + type (scoped search from regime block)
    reg_pos = str.pos(cleaned, '"regime":{"score":')
    if reg_pos >= 0
        sc_start = reg_pos + 18
        sc_end = str.pos(cleaned, ',', sc_start)
        if sc_end > sc_start
            summary_regime_score := tonumber(str.substring(cleaned, sc_start, sc_end))
        // type inside this regime object
        tp = str.pos(cleaned, '"type":"', reg_pos)
        if tp >= reg_pos
            tp_val = tp + 8
            tp_end = str.pos(cleaned, '"', tp_val)
            if tp_end > tp_val
                summary_regime := str.substring(cleaned, tp_val, tp_end)

    // Pillars dict as raw string for display label
    pil_pos = str.pos(cleaned, '"pillars":{')
    if pil_pos >= 0
        pil_end = str.pos(cleaned, '}', pil_pos)
        if pil_end > pil_pos
            summary_pillars_str := str.substring(cleaned, pil_pos + 11, pil_end)

    // top_details: [ {..}, {..} ... ]  -- split tolerant, enrich table rows with Python truth
    td_key = '"top_details":['
    td_pos = str.pos(cleaned, td_key)
    if td_pos >= 0
        td_start = td_pos + str.length(td_key)
        td_end = str.pos(cleaned, ']', td_start)
        if td_end > td_start
            dstr = str.substring(cleaned, td_start, td_end)
            objs = str.split(dstr, '},{')
            for ii = 0 to array.size(objs) - 1
                o = array.get(objs, ii)
                o := str.replace(o, '{', '')
                o := str.replace(o, '}', '')
                // ticker (string, use closing " for value)
                tkp = str.pos(o, '"ticker":"')
                if tkp >= 0
                    tks = tkp + 10
                    tke = str.pos(o, '"', tks)
                    if tke > tks
                        array.push(detail_tickers, str.substring(o, tks, tke))
                // composite (num)
                cp = str.pos(o, '"composite":')
                if cp >= 0
                    cs = cp + 12
                    ce1 = str.pos(o, ',', cs)
                    ce2 = str.pos(o, '}', cs)
                    ce = ce1 > 0 ? (ce2 > 0 ? math.min(ce1, ce2) : ce1) : ce2
                    if ce > cs
                        array.push(detail_composites, tonumber(str.substring(o, cs, ce)))
                // momentum (num, optional)
                mp = str.pos(o, '"momentum":')
                if mp >= 0
                    ms = mp + 11
                    me1 = str.pos(o, ',', ms)
                    me2 = str.pos(o, '}', ms)
                    me = me1 > 0 ? (me2 > 0 ? math.min(me1, me2) : me1) : me2
                    if me > ms
                        array.push(detail_momentums, tonumber(str.substring(o, ms, me)))
                    else
                        array.push(detail_momentums, na)
                else
                    array.push(detail_momentums, na)
                // passes_strict (bool)
                sp = str.pos(o, '"passes_strict":')
                if sp >= 0
                    ss = sp + 16
                    se1 = str.pos(o, ',', ss)
                    se2 = str.pos(o, '}', ss)
                    se = se1 > 0 ? (se2 > 0 ? math.min(se1, se2) : se1) : se2
                    if se > ss
                        sraw = str.substring(o, ss, se)
                        array.push(detail_stricts, sraw == "true")
                    else
                        array.push(detail_stricts, false)
                else
                    array.push(detail_stricts, false)
                // special_modes (string, last field often, use closing ")
                smp = str.pos(o, '"special_modes":"')
                if smp >= 0
                    sms = smp + 17
                    sme = str.pos(o, '"', sms)
                    if sme > sms
                        array.push(detail_specials, str.substring(o, sms, sme))
                    else
                        array.push(detail_specials, "")
                else
                    array.push(detail_specials, "")

                // rank (Python's authoritative rank in the recommended list - for exact table ordering + display)
                rnkp = str.pos(o, '"rank":')
                if rnkp >= 0
                    rnks = rnkp + 7
                    rnke1 = str.pos(o, ',', rnks)
                    rnke2 = str.pos(o, '}', rnks)
                    rnke = rnke1 > 0 ? (rnke2 > 0 ? math.min(rnke1, rnke2) : rnke1) : rnke2
                    if rnke > rnks
                        array.push(detail_ranks, math.round(tonumber(str.substring(o, rnks, rnke))))
                    else
                        array.push(detail_ranks, na)
                else
                    array.push(detail_ranks, na)

    // recommended_count (top-level int from Python's final dynamic selection)
    rc_pos = str.pos(cleaned, '"recommended_count":')
    if rc_pos >= 0
        rc_start = rc_pos + 20
        rc_end = str.pos(cleaned, ',', rc_start)
        if rc_end <= rc_start
            rc_end = str.pos(cleaned, '}', rc_start)
        if rc_end > rc_start
            rc_val = str.substring(cleaned, rc_start, rc_end)
            summary_recommended_count := math.round(tonumber(rc_val))

    // recommended_tickers array (the authoritative list of tickers Python marked recommended)
    // This lets the table show exact "Rec?" ✓ instead of local dyn approximation when full JSON is pasted.
    rt_key = '"recommended_tickers":['
    rt_pos = str.pos(cleaned, rt_key)
    if rt_pos >= 0
        rt_start = rt_pos + str.length(rt_key)
        rt_end = str.pos(cleaned, ']', rt_start)
        if rt_end > rt_start
            rt_str = str.substring(cleaned, rt_start, rt_end)
            rt_parts = str.split(rt_str, ',')
            for jj = 0 to array.size(rt_parts) - 1
                tkr = array.get(rt_parts, jj)
                tkr := str.replace(tkr, '"', '')
                tkr := str.trim(tkr)
                if tkr != ""
                    array.push(recommended_tickers_py, tkr)
            has_recommended_from_py := array.size(recommended_tickers_py) > 0

use_json_global := i_summary_json != "" and summary_regime != ""

// --- Regime Type Enum (for colors/logic) ---
f_regime_type(_score) =>
    if _score >= i_strong_th
        "STRONG"
    else if _score >= i_moderate_th
        "MODERATE"
    else if _score >= i_cautious_th
        "CAUTIOUS"
    else
        "WEAK"

// --- Per-symbol HYDRA Components (core of the spec) ---
f_compute_hydra(_sym) =>
    [c, r, mom, rs, dh, vr, ps, cm, sm] = request.security(_sym, timeframe.period, 
        [close, close[i_short_len], close[i_momentum_len], ta.highest(close, i_prox_len), 
         volume, volume], lookahead=barmerge.lookahead_off)

    // Short-term features
    ret_s   = (c / r - 1) * 100
    dist_h  = (c / rs - 1) * 100

    vrat = na
    if not na(vr) and vr > 0
        v20 = ta.sma(vr, 20)
        v5  = ta.sma(vr, 5)
        vrat := v5 / math.max(v20, 1)

    dth = i_vol_base + (i_geo_risk * 0.6)
    dth := math.max(MIN_VOL_TH, dth)
    strict = ret_s > i_strict_ret and dist_h >= i_strict_dist and (vrat > dth or na(vrat))

    // Momentum (risk-adjusted)
    m = (c / mom - 1)
    v = ta.stdev(ta.change(c)/c, i_vol_len) * math.sqrt(252)
    momentum = m / math.max(v, 0.0001)

    // Regime is market-wide (computed outside per-symbol for efficiency)
    // We pass it in

    [momentum, ret_s, dist_h, vrat, strict]

// --- Market Regime (computed once from SPY - SPEC 4.3 exact) ---
var float regime_score = 0.5
var string regime_t    = "MODERATE"
var float compass_m    = 1.0
var string special_m   = ""
var float rec_boost    = 1.0
var float pillar_compass = 1.0
var float pillar_rattle = 1.0
var float pillar_catalyst = 1.0
var float pillar_efa = 1.0

if barstate.islast
    if use_json_global and summary_regime != ""
        // B1: JSON-slave mode - bypass local global regime/special/pillar heavy calc (SPY request + subscores)
        // when full summary JSON with regime is provided. Use Python data for global visuals/labels.
        regime_score := summary_regime_score
        regime_t := summary_regime
        // pillars/special still use local derivation based on (JSON) regime_t for now; heavy local subscore calc skipped
    else
        spy_close = request.security(i_spy, timeframe.period, close, lookahead=barmerge.lookahead_off)
        if ta.barssince(not na(spy_close)) > i_regime_len
            curr = spy_close
            sma = ta.sma(spy_close, i_regime_len)

            // SPEC 4.3 Rich Regime - exact subscores and weights
            tr = curr > sma ? 1.0 : 0.0
            r20 = (curr / spy_close[20] - 1)
            trend_s = (tr * 0.6) + (math.clamp(r20 + 0.04, -0.1, 0.15) / 0.15 * 0.4)

            v20 = ta.stdev(ta.change(spy_close)/spy_close, 20) * math.sqrt(252)
            v200 = ta.stdev(ta.change(spy_close)/spy_close, i_regime_len) * math.sqrt(252)
            vr = v20 / math.max(v200, 0.01)
            vol_s = math.clamp(1 - (vr - 0.8) / 1.2, 0, 1)

            r60 = (curr / spy_close[60] - 1)
            mom_s = math.clamp((r20 * 0.6 + r60 * 0.4 + 0.05) / 0.20, 0, 1)

            mx = ta.highest(spy_close, 60)
            cdd = math.max(0.0, (mx - curr) / mx)
            dd20 = math.max(0.0, (mx - spy_close[20]) / mx)
            vel = math.max(0.0, cdd - dd20) / 20.0
            vel_s = 1.0 - math.clamp(vel * 40, 0, 1)

            breadth = 0.5

            overall = trend_s*0.30 + mom_s*0.25 + vol_s*0.20 + vel_s*0.15 + breadth*0.10
            regime_score := math.round(math.clamp(overall, 0, 1) * 1000) / 1000

            regime_t := f_regime_type(regime_score)

            // SPEC 4.4 Meta-Layer base + specials (exact)
            if regime_t == "STRONG"
                pillar_compass := 1.15
                pillar_rattle := 0.85
                pillar_catalyst := 0.70
                pillar_efa := 0.75
                rec_boost := 1.0
            else if regime_t == "MODERATE"
                pillar_compass := 1.05
                pillar_rattle := 0.95
                pillar_catalyst := 0.90
                pillar_efa := 0.92
            else if regime_t == "CAUTIOUS"
                pillar_compass := 0.88
                pillar_rattle := 1.12
                pillar_catalyst := 0.95
                pillar_efa := 0.98
                rec_boost := 1.0
            else
                pillar_compass := 0.75
                pillar_rattle := 1.18
                pillar_catalyst := 0.85
                pillar_efa := 0.90

            // Special modes (SPEC 4.4.2 exact triggers)
            dd = math.max(0.0, (ta.highest(spy_close, 60) - curr) / ta.highest(spy_close, 60))
            r20 = (curr / spy_close[20] - 1)
            r60 = (curr / spy_close[60] - 1)
            v = ta.stdev(ta.change(spy_close)/spy_close, 20) * math.sqrt(252)

            special_m := ""
            if dd >= 0.12 or (regime_score < 0.25 and v > 0.70)
                special_m := "CRISIS_ACUTE"
                pillar_compass *= 0.80
                pillar_rattle *= 0.95
                pillar_catalyst *= 0.75
                pillar_efa *= 0.80
            else if dd >= 0.06 and r20 > 0.025 and r60 > -0.08 and regime_score > 0.35
                rec_boost := math.min(1.0 + (dd - 0.06) * 1.5, 1.12)
                special_m := "POST_CRISIS_RECOVERY"
                pillar_compass *= 1.08
                pillar_rattle *= 0.95
            else if regime_score >= 0.68 and v < 0.55 and dd < 0.06
                special_m := "STRONG_BROAD_MOMENTUM"
                pillar_compass *= 1.22
                pillar_catalyst *= 0.60
                pillar_efa *= 0.65
            else if v > 0.68
                special_m := "ELEVATED_VOL_DEFENSIVE"
                pillar_rattle *= 1.15
                pillar_compass *= 0.92

            // Clamp (SPEC 4.4.3)
            pillar_compass := math.round(math.max(0.60, math.min(1.45, pillar_compass)) * 1000) / 1000
            pillar_rattle := math.round(math.max(0.60, math.min(1.45, pillar_rattle)) * 1000) / 1000
            pillar_catalyst := math.round(math.max(0.60, math.min(1.45, pillar_catalyst)) * 1000) / 1000
            pillar_efa := math.round(math.max(0.60, math.min(1.45, pillar_efa)) * 1000) / 1000

    compass_m := pillar_compass  // for backward compat in table

// --- Main symbol calculations (for the chart this script is applied to) ---
[mom_main, ret_main, dist_main, vrat_main, strict_main] = f_compute_hydra(syminfo.tickerid)

short_b = (math.clamp(ret_main / 20, -0.5, 1.5) + math.clamp((3.0 + dist_main) / 3.0, 0, 1)) / 2
comp_main = mom_main * (1 + short_b * SHORT_BOOST)
if strict_main
    comp_main *= (1 + STRICT_BONUS)
comp_main *= compass_m

// Dynamic count for this symbol (SPEC 4.7) - main chart is still local approx (table uses exact from JSON when provided)
dyn_count = math.clamp(math.round(i_base_recs * (regime_score > 0.5 ? 1.05 : 0.93) * compass_m), i_min_recs, i_max_recs)
// SPEC 4.7 - Downtrend Veto Gate (na TAMBIÉN veta; solo-en-negativo: ret >= 0 nunca se veta, igual que Python)
in_downtrend_main = i_gate_on and (na(dist_main) or na(ret_main) or (ret_main < 0 and ((dist_main < i_gate_dist) or (ret_main < i_gate_ret))))
is_rec_main = (comp_main > 0) and (regime_score >= i_min_regime_rec * 0.85) and not in_downtrend_main   // local approx for the chart this script is applied to; dashboard table uses Python recommended_tickers when i_summary_json provided

// --- Visuals on main chart ---
plot(comp_main, "Composite", color=color.new(color.aqua, 0), linewidth=2)
plot(regime_score, "Regime", color=color.orange, linewidth=1)

bgcolor(regime_t == "STRONG" ? color.new(color.green, 88) : 
        regime_t == "WEAK"   ? color.new(color.red, 88)   : na)

if i_show_pillars
    if use_json_global and summary_pillars_str != ""
        pillars_str = "P (Python): " + summary_pillars_str
    else
        pillars_str = "P: C×" + str.tostring(pillar_compass) + " R×" + str.tostring(pillar_rattle) + 
                      " Ca×" + str.tostring(pillar_catalyst) + " E×" + str.tostring(pillar_efa)
    label.new(bar_index, high, pillars_str, 
              style=label.style_label_left, color=color.new(color.blue, 70), textcolor=color.white, size=size.small)

if i_show_special and special_m != ""
    suffix = use_json_global ? " (from Python)" : " (SPEC 4.4.2)"
    label.new(bar_index, low, special_m + suffix, style=label.style_label_up, color=color.new(color.purple, 60), textcolor=color.white, size=size.small)

// Strict highlight
plotshape(strict_main, title="Strict Filter", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)

// --- Watchlist Dashboard Table (improved to match SPEC output contract) ---
// Now properly ranks the watchlist by composite (as per SPEC 4.5, 4.7)
// Shows recommended flag based on dynamic count approximation
var table t = table.new(position.top_right, 11, i_max_watchlist + 2, 
                        bgcolor=color.new(color.black, 15), frame_color=color.gray, border_width=1)

if barstate.islast and i_show_table
    // Header - closer to SPEC rich columns
    headers = array.from("Rank", "Ticker", "Comp", "Mom", "Reg", "Special", "Strict", "C_Mult", "Ret5d", "Dist", "Rec?")
    for i = 0 to 10
        table.cell(t, i, 0, array.get(headers, i), 
                   text_color=color.white, text_size=size.tiny, 
                   bgcolor=color.new(color.blue, 0), alignment=align_center)

    // Parse watchlist
    syms = str.split(i_watchlist, ",")
    valid_syms = array.new_string()
    for s in syms
        s2 = str.trim(s)
        if s2 != ""
            array.push(valid_syms, s2)

    n = math.min(array.size(valid_syms), i_max_watchlist)

    // B2: optional filter to only Python recommended (when JSON and toggle)
    if i_only_recommended and has_recommended_from_py and array.size(recommended_tickers_py) > 0
        filtered = array.new_string()
        for ii = 0 to array.size(valid_syms) - 1
            s = array.get(valid_syms, ii)
            for k = 0 to array.size(recommended_tickers_py) - 1
                if s == array.get(recommended_tickers_py, k)
                    array.push(filtered, s)
                    break
        valid_syms := filtered
        n := math.min(array.size(valid_syms), i_max_watchlist)

    // Collect data for proper ranking (SPEC 4.5 composite + 4.7 dynamic)
    // Use parallel arrays for sorting
    tickers = array.new_string()
    comps = array.new_float()
    moms = array.new_float()
    rets = array.new_float()
    dists = array.new_float()
    vrs = array.new_float()
    stricts = array.new_bool()
    specials = array.new_string()
    py_ranks = array.new_float()  // Python rank when available from JSON (for exact ordering/display)

    for i = 0 to n-1
        sym = array.get(valid_syms, i)
        [m, rs, dh, vr, ps] = f_compute_hydra(sym)

        // Full composite using shared meta (SPEC 4.5)
        sb = (math.clamp(rs / 20, -0.5, 1.5) + math.clamp((3.0 + dh) / 3.0, 0, 1)) / 2
        comp = m * (1 + sb * SHORT_BOOST)
        if ps
            comp *= (1 + STRICT_BONUS)
        comp *= compass_m

        // Enrich/override with Python top_details if this ticker is present.
        // Python values are preferred: they reflect full SPEC (sector control 4.6, exact dynamic ranking, full history, etc.)
        // Local request.security is only approx for the pasted watchlist symbols.
        enriched = false
        for j = 0 to array.size(detail_tickers) - 1
            if array.get(detail_tickers, j) == sym
                py_c = array.get(detail_composites, j)
                if not na(py_c)
                    comp := py_c
                py_m = array.get(detail_momentums, j)
                if not na(py_m)
                    m := py_m
                ps := array.get(detail_stricts, j)
                py_sm = array.get(detail_specials, j)
                use_sm = py_sm != "" ? py_sm : special_m
                py_rnk = array.get(detail_ranks, j)
                array.push(tickers, sym)
                array.push(comps, comp)
                array.push(moms, m)
                array.push(rets, rs)
                array.push(dists, dh)
                array.push(vrs, vr)
                array.push(stricts, ps)
                array.push(specials, use_sm)
                array.push(py_ranks, py_rnk)
                enriched := true
                break
        if not enriched
            // no python detail match for this sym, use local calc + market special
            array.push(tickers, sym)
            array.push(comps, comp)
            array.push(moms, m)
            array.push(rets, rs)
            array.push(dists, dh)
            array.push(vrs, vr)
            array.push(stricts, ps)
            array.push(specials, special_m)  // market level for now
            array.push(py_ranks, na)

    // Sort logic: when full Python JSON with recommended data is provided, sort by Python's rank (exact order).
    // Otherwise fall back to sorting by (enriched) composite.
    indices = array.new_int()
    for i = 0 to n-1
        array.push(indices, i)

    if has_recommended_from_py and array.size(recommended_tickers_py) > 0
        // Prefer Python rank order for the symbols we have data for
        for i = 0 to n-2
            for j = 0 to n-i-2
                idx1 = array.get(indices, j)
                idx2 = array.get(indices, j+1)
                r1 = array.get(py_ranks, idx1)
                r2 = array.get(py_ranks, idx2)
                // lower rank number = better (1 is top). na ranks go to the end.
                if (not na(r1) and not na(r2) and r1 > r2) or (na(r1) and not na(r2))
                    array.set(indices, j, idx2)
                    array.set(indices, j+1, idx1)
                else if na(r1) and na(r2)
                    // both local, fall back to comp
                    if array.get(comps, idx1) < array.get(comps, idx2)
                        array.set(indices, j, idx2)
                        array.set(indices, j+1, idx1)
    else
        // Simple bubble sort for small n (Pine has no built-in sort with comparator easily)
        for i = 0 to n-2
            for j = 0 to n-i-2
                idx1 = array.get(indices, j)
                idx2 = array.get(indices, j+1)
                if array.get(comps, idx1) < array.get(comps, idx2)
                    // swap
                    array.set(indices, j, idx2)
                    array.set(indices, j+1, idx1)

    // Dynamic count (used only as fallback for is_rec when no recommended_tickers from Python JSON)
    dyn = math.clamp(math.round(i_base_recs * (regime_score > 0.5 ? 1.05 : 0.93) * compass_m), i_min_recs, i_max_recs)

    // Build ranked table
    for rank = 1 to n
        idx = array.get(indices, rank-1)
        sym = array.get(tickers, idx)
        comp = array.get(comps, idx)
        m = array.get(moms, idx)
        rs = array.get(rets, idx)
        dh = array.get(dists, idx)
        vr = array.get(vrs, idx)
        ps = array.get(stricts, idx)
        sm = array.get(specials, idx)
        py_rnk = array.get(py_ranks, idx)

        // is_rec: use exact Python recommended list when full JSON was provided (authoritative)
        // Falls back to local dyn approximation only if no recommended_tickers in the JSON.
        is_rec = false
        if has_recommended_from_py and array.size(recommended_tickers_py) > 0
            for k = 0 to array.size(recommended_tickers_py) - 1
                if array.get(recommended_tickers_py, k) == sym
                    is_rec := true
                    break
        else
            // SPEC 4.7 - Downtrend Veto Gate también en el fallback local (na TAMBIÉN veta; solo-en-negativo)
            in_dt = i_gate_on and (na(dh) or na(rs) or (rs < 0 and ((dh < i_gate_dist) or (rs < i_gate_ret))))
            is_rec := (rank <= dyn) and (regime_score >= i_min_regime_rec * 0.85) and not in_dt

        row_bg = color.new(color.black, 20)
        if i_color_rows
            if ps
                row_bg := color.new(color.green, 70)
            else if is_rec
                row_bg := color.new(color.lime, 80)
            else if regime_t == "STRONG"
                row_bg := color.new(color.green, 85)
            else if regime_t == "WEAK"
                row_bg := color.new(color.red, 85)

        mode_color = color.white
        if ps or sm == "STRONG_BROAD_MOMENTUM" or sm == "MOMENTUM"
            mode_color := color.lime
        else if sm == "CRISIS_ACUTE" or sm == "CRISIS" or sm == "ELEVATED_VOL_DEFENSIVE" or sm == "DEFENSIVE" or sm == "VOL_DEF"
            mode_color := color.orange

        rec_str = is_rec ? "✓" : ""

        // Display Python rank if we have it from JSON (makes the table follow Python's exact ordering and numbering)
        display_rank = not na(py_rnk) ? py_rnk : rank
        rank_str = not na(py_rnk) ? str.tostring(py_rnk) : str.tostring(rank)
        table.cell(t, 0, rank, rank_str, text_size=size.tiny, bgcolor=row_bg, alignment=align_center)
        table.cell(t, 1, rank, sym, text_size=size.tiny, bgcolor=row_bg, text_color=color.white)
        table.cell(t, 2, rank, str.tostring(comp, "#.####"), text_size=size.tiny, bgcolor=row_bg, text_color=color.aqua)
        table.cell(t, 3, rank, str.tostring(m, "#.####"), text_size=size.tiny, bgcolor=row_bg)
        table.cell(t, 4, rank, regime_t, text_size=size.tiny, bgcolor=row_bg, text_color=regime_t == "STRONG" ? color.lime : color.white)
        table.cell(t, 5, rank, sm, text_size=size.tiny, bgcolor=row_bg, text_color=mode_color)
        table.cell(t, 6, rank, ps ? "✓" : "—", text_size=size.tiny, bgcolor=row_bg, text_color=ps ? color.lime : color.gray)
        table.cell(t, 7, rank, str.tostring(compass_m, "0.00"), text_size=size.tiny, bgcolor=row_bg)
        table.cell(t, 8, rank, str.tostring(rs, "0.0")+"%", text_size=size.tiny, bgcolor=row_bg)
        table.cell(t, 9, rank, str.tostring(dh, "0.0")+"%", text_size=size.tiny, bgcolor=row_bg)
        table.cell(t, 10, rank, rec_str, text_size=size.tiny, bgcolor=row_bg, text_color=is_rec ? color.lime : color.gray)

    // Footer
    table.cell(t, 0, n+1, "Rank (PyRank when JSON) + exact Rec? from Python | Composite/Mom/Strict/Special from top_details when provided | Full SPEC in Python", 
               text_size=size.tiny, text_color=color.gray, colspan=11)

// --- Alerts (webhook friendly) ---
alertcondition(strict_main and comp_main > 0.7, 
               "HYDRA: Strict + Strong Composite", 
               "HYDRA ALERT: {{ticker}} | Comp={{close}} | Regime=" + regime_t + " | Strict=YES | COMPASS×" + str.tostring(compass_m))

alertcondition(regime_t == "STRONG" and (special_m == "STRONG_BROAD_MOMENTUM" or special_m == "MOMENTUM"), 
               "HYDRA: Strong Broad Momentum Regime", 
               "HYDRA: Market in STRONG_BROAD_MOMENTUM - favor COMPASS stocks")

// --- Info label on chart ---
if barstate.islast
    info = "HYDRA | Regime: " + regime_t + " (" + str.tostring(regime_score) + 
           ") | COMPASS×" + str.tostring(compass_m) + 
           (special_m != "" ? " | " + special_m : "") +
           (strict_main ? " | STRICT ✓" : "") +
           (use_json_global and summary_recommended_count > 0 ? " | Python Recs: " + str.tostring(summary_recommended_count) : "")
    label.new(bar_index, high * 1.01, info, 
              style=label.style_label_down, color=color.new(color.black, 40), 
              textcolor=color.white, size=size.small)

    // If summary JSON provided, show richer global header (rationale + pillars + recommended count from Python side)
    if i_summary_json != "" and (summary_rationale != "" or summary_pillars_str != "")
        header = "GLOBAL FROM PYTHON: " + (summary_regime != "" ? "Regime " + summary_regime + " (" + str.tostring(summary_regime_score) + ") | " : "")
        header += (summary_pillars_str != "" ? "Pillars: " + summary_pillars_str + " | " : "")
        header += (summary_recommended_count > 0 ? "Recs: " + str.tostring(summary_recommended_count) + " | " : "")
        header += (summary_rationale != "" ? summary_rationale : "")
        label.new(bar_index, high * 1.03, header, 
                  style=label.style_label_down, color=color.new(color.orange, 50), 
                  textcolor=color.white, size=size.small)

// Note at bottom (SPEC aligned, hybrid flow)
// For best results with large universes:
// 1. Run Python screener daily with UNIVERSE="all" (full SPEC logic + history)
// 2. The Python auto-generates pine/watchlist.txt + pine/hydra_last_summary.json (via integration in screener.py / run_real...)
// 3. Paste the watchlist string into "Watchlist Symbols".
// 4. (Recommended) Paste the FULL content of hydra_last_summary.json into "i_summary_json" input → richer global header + per-row enrichment:
//      - Rank column shows Python rank, table is sorted by Python rank when recommended data present.
//      - Composite, Momentum, Strict, Special, and exact "Rec?" come from Python's top_details + recommended_tickers (full SPEC).
//      - When regime in JSON: bypass local global regime calc (B1 JSON-slave mode) for efficiency; visuals/labels from Python.
//      - Local Pine calculations are fallback only.
// 5. Use the ranked table as daily HYDRA dashboard (Python ordering + values when JSON provided).
// 6. Set alerts (e.g. "HYDRA: Strict + Strong Composite") and forward via TV webhooks or the Python sender (Discord/Telegram/generic).

// Per-symbol calculations match SPEC 4.1-4.5 closely. Full sector (4.6) and exact dynamic count for 2500+ stay in Python (heavy lifter).
// See HYDRA_ALGORITHM_SPEC.md + HYBRID_USAGE.md for details.