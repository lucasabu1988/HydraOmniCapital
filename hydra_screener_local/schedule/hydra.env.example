# TASK-364 — environment for the scheduled run. Copy to schedule\hydra.env (gitignored) and fill in.
# One KEY=VALUE per line, no quotes, no spaces around '='. Lines starting with # are ignored.

# Python interpreter used by run_daily.cmd
PYTHON=C:\Python314\python.exe

# Off-disk backup of state/, instruction sheets, runs/ and PIT snapshots (preflight WARNs when unset)
HYDRA_BACKUP_DIR=D:\hydra_backups

# Universe for the ritual (production: all)
UNIVERSE=all

# Alert transports besides the always-on state\alerts.log: comma list of discord,telegram
HYDRA_NOTIFY=file

# Secrets for the network transports (leave empty to disable)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
