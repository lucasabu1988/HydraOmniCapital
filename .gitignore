```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Data cache (assuming these are generated/intermediate files)
data_cache/

# Dependencies and virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
build/
dist/
target/

# Logs and temporary files
*.log
*.tmp
*.swp

# Coverage reports
.coverage
coverage/
htmlcov/

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db
```